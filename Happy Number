class Solution:
    def isHappy(self, n): 
        seen = set()
        
        while n != 1 and n not in seen:
            seen.add(n)
            digits = str(n)
            
         
            total_sum = 0
            for char in digits:
                digit = int(char)
                total_sum += digit * digit
            
          
            n = total_sum
            
        return n == 1
