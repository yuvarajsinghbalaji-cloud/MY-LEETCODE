class Solution:
    def addStrings(self, num1,num2): 
        i, j, carry, res = len(num1) - 1, len(num2) - 1, 0, ""
    
        while i >= 0 or j >= 0 or carry:
            n1 = ord(num1[i]) - 48 if i >= 0 else 0
            n2 = ord(num2[j]) - 48 if j >= 0 else 0
            
            total = n1 + n2 + carry
            carry = total // 10
            res = str(total % 10) + res
            
            i, j = i - 1, j - 1
            
        return res
